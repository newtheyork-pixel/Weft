<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tessera.Weft.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- weftnative:// is unique to this native app, so the OAuth
				     callback never collides with the Electron app, which also
				     registers weft://. weft:// is kept so the native app can
				     reclaim it (and serve emailed weft:// links) once Electron
				     is retired. -->
				<string>weftnative</string>
				<string>weft</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
