<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.tessera.Weft.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- weftnative:// is unique to this native app, so the OAuth
				     callback never collides with the Electron app, which also
				     registers weft://. weft:// is kept so the native app can
				     reclaim it (and serve emailed weft:// links) once Electron
				     is retired. -->
				<string>weftnative</string>
				<string>weft</string>
			</array>
		</dict>
	</array>
	<!-- Sparkle auto-update. The feed is published to the weft-releases default
	     branch by scripts/release.sh (generate_appcast). SUPublicEDKey is the
	     EdDSA public key; its private half lives in the build machine's keychain
	     and signs each update. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/newtheyork-pixel/weft-releases/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>fiG4V8WKwWAm8avUBbxMvLEwN3/vPQcx5NI3h1oD4fs=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
