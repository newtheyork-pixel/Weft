# Copy to scripts/.env.signing (gitignored) and fill in.
# Same Apple Developer credentials your Electron app's .env.signing uses.

# Your Apple Developer Team ID (already the project's team).
APPLE_TEAM_ID=PW2VT56789

# The Apple ID email on the Developer account.
APPLE_ID=you@example.com

# An app-specific password (NOT your Apple ID password):
#   appleid.apple.com → Sign-In and Security → App-Specific Passwords → +
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# A GitHub token with contents:write on newtheyork-pixel/weft-releases.
# (export it in your shell, or set it here.)
GH_TOKEN=ghp_xxx
